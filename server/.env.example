# 复制为 .env 后按需修改（.env 不入库）

# 监听地址与端口：nginx 反代到这里，只监听本机
HOST=127.0.0.1
PORT=3100

# SQLite 数据库文件路径（相对 server/ 目录或绝对路径）
DB_PATH=./data/invitation.db

# 管理接口令牌（/api/admin/*），务必改成足够长的随机串：openssl rand -hex 24
ADMIN_TOKEN=change-me

# 允许跨域的前端来源，逗号分隔。
# 前端与接口同域（nginx 把 /api 反代到本服务）时留空即可；
# 前端在别的域名（如 EdgeOne）、接口在 api 子域时填前端域名。
CORS_ORIGINS=

# 额外的祝福屏蔽词，逗号分隔（内置了一小份基础词表）
BLOCK_WORDS=

# 微信 JS-SDK 签名（分享卡片、微信内打开地图）。服务号的 AppID / AppSecret
# 同一 AppID 只能由一处换取 access_token：配在这里后，EdgeOne 上不要再配置 WX_APPSECRET
WX_APPID=
WX_APPSECRET=
# 允许签名的页面域名（含子域），逗号分隔
WX_SIGN_DOMAINS=xjj-love-byy.cloud
